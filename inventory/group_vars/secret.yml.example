---
# Per-host secrets template. Copy to a file named after the host's leaf group
# (e.g. web1.yml, web2.yml) — these are gitignored.
#
# Storing the sudo password here (Vault-encrypted) lets you drop the `-K` flag.
# Generate the encrypted value with:
#
#   ansible-vault encrypt_string --stdin-name 'ansible_become_password'
#
# then type the sudo password, Enter, Ctrl-D, and paste the block below.
# The vault password itself is read from the file named in ansible.cfg
# (vault_password_file). See the README for the full setup.
#
# ansible_become_password: !vault |
#           $ANSIBLE_VAULT;1.1;AES256
#           66386439...
